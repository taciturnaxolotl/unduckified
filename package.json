{
  "name": "unduckified",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "bun run hash && bun run src/bangs/packbang.ts && bunx --bun vite",
    "build": "bun run hash && bun run src/bangs/packbang.ts && bunx --bun vite build && bun run src/build-workers.ts",
    "preview": "bunx --bun vite preview",
    "hash": "bun run src/bangs/hashbanggen.ts",
    "ranks": "bun run src/bangs/fetch-ranks.ts",
    "check": "bun run src/bangs/test-bangs.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "@types/bun": "^1.3.14",
    "vite-plugin-pwa": "^0.21.2"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001806"
  }
}
